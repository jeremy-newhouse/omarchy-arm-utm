# Template. build-omarchy-arm.sh generates the real version at $W/provision/config.env
# with the values from the questionnaire (or the defaults with --yes), and puts it
# into the provisioning ISO. This file is only for manual runs.
VM_USER="builder"
VM_PASSWORD="builder"
VM_FULLNAME="Omarchy ARM"
VM_EMAIL="user@example.com"
VM_HOSTNAME="omarchy"
VM_TIMEZONE="Europe/Madrid"
VM_KEYMAP="us"
VM_XKB="us"
VM_LOCALE="en_US.UTF-8"
VM_LOCALE_EXTRA=""
DISK="/dev/vda"
DIST_OLD_USER="builder"
DIST_NEW_USER="omarchy"
WANT_TOOLS="yes"
WANT_EXTRAS="yes"
