# Plantilla. build-omarchy-arm.sh genera la version real en $W/provision/config.env
# con los valores del cuestionario (o los de por defecto con --yes), y la mete en
# el ISO de aprovisionamiento. Este fichero solo sirve para pasadas manuales.
VM_USER="builder"
VM_PASSWORD="builder"
VM_FULLNAME="Omarchy ARM"
VM_EMAIL="usuario@ejemplo.com"
VM_HOSTNAME="omarchy"
VM_TIMEZONE="Europe/Madrid"
VM_KEYMAP="es"
VM_XKB="es"
VM_LOCALE="en_US.UTF-8"
VM_LOCALE_EXTRA="es_ES.UTF-8"
DISK="/dev/vda"
DIST_OLD_USER="builder"
DIST_NEW_USER="omarchy"
HACER_TOOLS="si"
HACER_LIBRES="si"
